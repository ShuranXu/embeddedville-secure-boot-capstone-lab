{
  "name": "EmbeddedVille Secure Boot Capstone",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "postCreateCommand": "python3 -m pip install --user --disable-pip-version-check -r requirements-build.txt && ./scripts/readiness.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  },
  "remoteUser": "vscode"
}

